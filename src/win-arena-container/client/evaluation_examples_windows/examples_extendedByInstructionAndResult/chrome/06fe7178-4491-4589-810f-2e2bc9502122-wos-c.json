{
  "id": "06fe7178-4491-4589-810f-2e2bc9502122-wos-c",
  "snapshot": "chrome",
  "instruction": "I accidentally closed some tabs, how can I get them back?",
  "source": "https://www.wikihow.com/Switch-Tabs-in-Chrome",
  "config": [
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337",
          "--force-renderer-accessibility"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "https://www.netflix.com",
          "https://www.spotify.com",
          "https://www.twitter.com",
          "https://www.linkedin.com"
        ]
      }
    },
    {
      "type": "chrome_close_tabs",
      "parameters": {
        "urls_to_close": [
          "https://www.twitter.com",
          "https://www.linkedin.com"
        ]
      }
    }
  ],
  "trajectory": "trajectories\\",
  "related_apps": [
    "chrome"
  ],
  "evaluator": {
    "func": "is_expected_tabs",
    "result": {
      "type": "open_tabs_info"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "type": "url",
        "urls": [
          "https://www.netflix.com",
          "https://www.spotify.com",
          "https://www.twitter.com",
          "https://www.linkedin.com"
        ]
      }
    }
  }
